# 部署環境設定範本。實際使用的是 deploy/.env（已 gitignore，不進版控）。
#
# 建立方式（建議）：surgann setup        ← 互動問答；或 surgann setup --yes 全用預設
#   setup 以本檔為底建立 deploy/.env；之後重跑只補缺的鍵，不會覆蓋你改過的值（--force 才覆蓋）。
# 手動建立亦可：cp deploy/.env.example deploy/.env 再編輯。
#
# 平台為單一 host 進程（SurgAnnFlow Annotator，無 Docker）；本檔只放 annotator 與資料位置設定。
# API token / 帳密日後也只能放 deploy/.env（不要寫進程式或 commit）。

# --- SurgAnnFlow Annotator（標註介面；瀏覽器開這個 port）---
ANNOTATOR_PORT=8090
# 標註頁頂欄「標註者」的預設值（單人使用時的預設；目前尚無多人帳號系統）
ANNOTATOR_NAME=annotator1

# --- data 根（影片、抽幀、匯出、模型、快取都放這底下）---
# 留空 = 專案目錄下的 data/。影片很佔空間，建議指到大容量磁碟的絕對路徑，例如：
#   SURGANN_DATA_DIR=/mnt/bigdisk/surgannflow-data
# 優先順序：環境變數 SURGANN_DATA_DIR > 本檔 > <專案>/data
# 注意：registry/（標註資料庫）與 backups/ 固定留在專案目錄內，不跟著搬。
# 已有資料後若要改位置：先整包搬移該目錄，再改這裡（registry 內存的是相對 data 根的路徑）。
SURGANN_DATA_DIR=

# --- 時區 ---
# 留空 = 用作業系統的時區（timedatectl 可查）。要指定時填 IANA 名稱，例如 Asia/Taipei。
# 每次執行 surgann 指令時套用（影響時間戳、備份/匯出檔名）；若啟動時已有 TZ 環境變數則以它為準。
# 用 systemd 常駐時，surgann setup --systemd 也會把此值寫進 unit（改值後需重跑並重裝 unit）。
TZ=

# --- OOB 模型授權同意紀錄（勿手填）---
# OOB 模型（OOBNet，CC BY-NC-SA 4.0，僅限非商業研究）隨 repo 附帶於 pipeline/models/oob/，
# 但「附帶」不等於同意。由 surgann fetch-models --only oob 在使用者本人閱讀授權並輸入 accept 後
# 自動寫入當天日期（YYYY-MM-DD）。留空＝未同意：標註照常，但影片上傳入庫的去識別化（OOB）不可用。
# AI agent 不可代為同意或填寫此值。
OOB_LICENSE_ACCEPTED=
